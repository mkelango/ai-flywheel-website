{
  "name": "ai-flywheel-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"API_PORT=8787 node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "API_PORT=8787 node --watch server/index.js",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "build": "node scripts/gen-sitemap.mjs && node scripts/gen-og.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^11.3.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.408.0",
    "nanoid": "^5.1.11",
    "nodemailer": "^8.0.10",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}

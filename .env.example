# ── The AI Flywheel — server configuration ──────────────────────────────────
# Copy to .env and fill in. Everything works WITHOUT these (outbox email +
# demo checkout); add them to go fully live.

PORT=8787
APP_URL=http://localhost:5174
# Set to "production" on your server to enable CORS restriction + JWT safe-fallback
NODE_ENV=

# Auth — REQUIRED in production (a long random string). If unset in production the
# server uses a random per-process secret (sessions reset on restart).
JWT_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated allowed origins in production (defaults to APP_URL).
# Only matters for cross-site API callers; the SPA is served same-origin.
CORS_ORIGIN=

# Email (SMTP). Without these, emails are written to server/data/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=The AI Flywheel <hello@aiflywheel.example>

# Payments — Stripe (global) and/or Razorpay (India). Without these, checkout
# runs in safe demo mode (no charge).
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

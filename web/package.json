{
  "name": "ai-flywheel-web",
  "private": true,
  "workspaces": [
    "apps/flywheel",
    "apps/schools",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n flywheel,schools -c auto \"npm:dev:flywheel\" \"npm:dev:schools\"",
    "dev:flywheel": "npm run dev -w @flywheel/site-flywheel",
    "dev:schools": "npm run dev -w @flywheel/site-schools",
    "build": "npm run build -w @flywheel/site-flywheel && npm run build -w @flywheel/site-schools",
    "typecheck": "tsc -p apps/flywheel --noEmit && tsc -p apps/schools --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
